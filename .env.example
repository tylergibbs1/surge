# Core data sources
EIA_API_KEY=
NREL_API_KEY=
PJM_SUBSCRIPTION_KEY=
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
NCDC_TOKEN=

# Python API and model
SURGE_DATA_DIR=./.surge-data
SURGE_MODEL_PATH=amazon/chronos-2
SURGE_MODEL_REVISION=29ec3766d36d6f73f0696f85560a422f50e8498c
SURGE_MODEL_NAME=chronos-2
# Both are required with a custom fine-tune; attest the contract digest and the
# deterministic SHA-256 of the extracted model tree.
SURGE_MODEL_FEATURE_SPEC_SHA256=
SURGE_MODEL_ARTIFACT_SHA256=
SURGE_CODE_REVISION=dev
SURGE_ALLOWED_ORIGINS=http://localhost:3000
SURGE_DATA_WARN_HOURS=6
SURGE_DATA_CRITICAL_HOURS=12
SURGE_LEDGER_KEY=

# Modal deployment selectors (read locally when modal_app/app.py is loaded)
SURGE_MODAL_APP=surge-api-v02
SURGE_MODAL_VOLUME=surge-grid-v02
SURGE_SEED_DIR=./data_snapshot

# Playground server routes; never prefix server-only secrets with NEXT_PUBLIC_
SURGE_API_URL=http://127.0.0.1:8000
# Production must use the distinct Modal ledger_publisher_app origin. That
# function is capped at one container; the public fastapi_app rejects writes.
SURGE_PUBLISHER_URL=http://127.0.0.1:8000
# Exact comma-separated host allowlist for the authenticated bake route. Add a
# versioned publisher host here before switching SURGE_PUBLISHER_URL to it.
SURGE_ALLOWED_API_HOSTS=127.0.0.1,localhost,tylergibbs1--surge-api-v02-ledger-publisher-app.modal.run
BLOB_READ_WRITE_TOKEN=
BAKE_SECRET=
RUNPOD_API_KEY=
